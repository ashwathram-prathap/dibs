{
  "name": "dibs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/configure-drop.ts && tsx scripts/build-house-words.ts && tsx scripts/build-catalog-assets.ts && tsx scripts/build-scores.ts && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev --local -c worker/wrangler.jsonc --port 8787 --env-file .dev.vars",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "categories": "tsx scripts/build-category.ts",
    "deploy:api": "tsx scripts/check-r11-release.ts && tsx scripts/check-deploy-freeze.ts --production && tsx scripts/configure-drop.ts && tsx scripts/build-house-words.ts && wrangler deploy -c worker/wrangler.jsonc",
    "deploy:web": "tsx scripts/check-r11-release.ts && tsx scripts/check-deploy-freeze.ts --production && npm run build && wrangler pages deploy dist --project-name dibs",
    "check": "tsc -b && tsc -p tsconfig.worker.json",
    "test:emoji": "tsx scripts/emoji-check.ts",
    "catalog:coverage": "tsx scripts/check-coverage.ts",
    "backup": "sh scripts/backup-production.sh"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "framer-motion": "12.43.0",
    "html-to-image": "1.11.13",
    "opentype.js": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "lighthouse": "13.6.0",
    "miniflare": "5.20261119.0-beta",
    "pluralize": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wawoff2": "2.0.1",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "fflate": "0.8.2"
  }
}
