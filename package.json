{
  "name": "dibs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc --port 8787 --env-file .dev.vars",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "categories": "tsx scripts/build-category.ts",
    "deploy:api": "wrangler deploy -c worker/wrangler.jsonc",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name dibs",
    "check": "tsc -b && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "framer-motion": "^12.23.0",
    "html-to-image": "^1.11.13",
    "opentype.js": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@cloudflare/workers-types": "latest",
    "@fontsource-variable/archivo": "latest",
    "@fontsource-variable/instrument-sans": "latest",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "lighthouse": "latest",
    "miniflare": "^5.20261119.0-beta",
    "pngjs": "latest",
    "prettier": "^3.10.1",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "fflate": "^0.8.2"
  }
}
