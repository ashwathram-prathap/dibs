{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dibs-api",
  "main": "index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "account_id": "5cf62cff0219727f2121253b3924f886",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dibs-db",
      "database_id": "b4d0eb75-781e-489c-bc0f-504fcfc879d9",
      "migrations_dir": "../migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }, { "name": "IMAGE_CACHE", "class_name": "ImageCache" }] },
  "migrations": [{ "tag": "r2-registry-cache", "new_sqlite_classes": ["Registry", "ImageCache"] }],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGLNsW8c9WxZVAxQ",
  },
  "triggers": {
    "crons": ["17 5 * * *", "5 0 * * *"],
  },
  "observability": {
    "enabled": false,
  },
  "preview_urls": false,
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.woff", "**/*.otf"],
      "fallthrough": true,
    },
  ],
}
